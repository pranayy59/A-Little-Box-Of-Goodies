{
  "name": "little-box-of-goodies",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "npm run db:migrate && next start --hostname 0.0.0.0",
    "db:migrate": "node --env-file-if-exists=.env scripts/prepare-db.mjs && prisma migrate deploy",
    "db:setup": "node --env-file=.env scripts/prepare-db.mjs && prisma migrate deploy && node prisma/seed.mjs",
    "postinstall": "prisma generate",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "prisma": "6.19.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
